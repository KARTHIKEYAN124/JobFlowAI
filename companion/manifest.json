{
  "manifest_version": 3,
  "name": "JobFlow AI Companion",
  "version": "1.1.0",
  "description": "Fills reviewed application details and collects unanswered employer questions.",
  "permissions": [],
  "host_permissions": [
    "https://jobflow-ai-delta.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
