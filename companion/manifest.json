{
  "manifest_version": 3,
  "name": "JobFlow AI Companion",
  "version": "1.3.2",
  "description": "Fills reviewed application details, imports tailored resumes, and collects employer questions.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://jobflow-ai-delta.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://jobflow-ai-delta.vercel.app/portal-launch*"],
      "js": ["launch.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
