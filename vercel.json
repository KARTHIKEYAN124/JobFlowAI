{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "routes": [
        {
          "src": "/backend/(.*)",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/$1" }
          ]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/backend/:path*", "destination": { "service": "backend", "path": "/:path*" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
